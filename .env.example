# Copier vers .env.local et compléter.

# Supabase — URL du projet. Publique : elle sert à construire l'URL des images
# produit (bucket public) et alimente images.remotePatterns dans next.config.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SERVEUR pour l'écriture dans le Storage (upload/suppression d'images).
# ⚠ JAMAIS de préfixe NEXT_PUBLIC_ : toute variable ainsi préfixée est inlinée
#   dans le bundle envoyé au navigateur, donc publiée.
# Préférer une clé restreinte au bucket `coquelicot-bucket` plutôt que la clé
# `service_role`, qui contourne toute RLS sur l'ensemble du projet Supabase.
SUPABASE_SECRET_KEY=

# Postgres direct pour Drizzle (Supabase → Connect → Transaction pooler).
# Si absente en local, l'app utilise une base PGlite embarquée (.data/pglite),
# migrée et seedée automatiquement. OBLIGATOIRE en production (Vercel).
DATABASE_URL=

# Stripe (mode test : rk_test_/pk_test_/sk_test_)
STRIPE_RESTRICTED_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Secret du endpoint webhook (Dashboard Stripe → Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Back-office — session signée (jose HS256) : `openssl rand -base64 32`
SESSION_SECRET=
# Compte admin unique (Léa). Hash bcrypt :
#   node -e "console.log(require('bcryptjs').hashSync('votre-mot-de-passe',10))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# URL publique du site (success/cancel Stripe). Ex : https://coquelicot-lr.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 — ID de mesure (Admin → Flux de données → Web).
# Laisser vide ou sur le placeholder G-XXXXXXXXXX pour désactiver l'analytics
# (utile en dev pour ne pas polluer les stats de prod).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mondial Relay — widget (public) + API Connect (serveur)
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=BDTEST
MONDIAL_RELAY_API_URL=https://connect-api-sandbox.mondialrelay.com
MONDIAL_RELAY_API_LOGIN=BDTEST@business-api.mondialrelay.com
MONDIAL_RELAY_API_PASSWORD=2crtPDo0ZL7Q*3kLumB  # mot de passe public BDTEST (sandbox officielle Mondial Relay — pas un secret)
MONDIAL_RELAY_CUSTOMER_ID=BDTEST

# Resend — formulaire de contact (e-mail transactionnel).
# Clé API : Dashboard Resend → API Keys. Si absente : en dev le formulaire
# simule un envoi (succès no-op) ; en prod il renvoie une erreur explicite.
RESEND_API_KEY=
# Destinataire des messages (boîte de la boutique). Défaut : bonjour@coquelicot-lr.fr
CONTACT_TO=
# Expéditeur. DOIT être une adresse d'un domaine vérifié dans Resend en prod
# (ex. "Coquelicot <contact@coquelicot-lr.fr>"). Sans domaine vérifié, Resend
# n'autorise que "Coquelicot <onboarding@resend.dev>" (livré au seul compte).
CONTACT_FROM=

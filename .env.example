# Copier vers .env.local et compléter.

# Supabase (client public — non utilisé côté serveur pour l'instant)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres direct pour Drizzle (Supabase → Connect → Transaction pooler).
# Si absente en local, l'app utilise une base PGlite embarquée (.data/pglite),
# migrée et seedée automatiquement. OBLIGATOIRE en production (Vercel).
DATABASE_URL=

# Stripe (mode test : rk_test_/pk_test_/sk_test_)
STRIPE_RESTRICTED_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# Secret du endpoint webhook (Dashboard Stripe → Webhooks, ou `stripe listen`)
STRIPE_WEBHOOK_SECRET=

# Back-office — session signée (jose HS256) : `openssl rand -base64 32`
SESSION_SECRET=
# Compte admin unique (Léa). Hash bcrypt :
#   node -e "console.log(require('bcryptjs').hashSync('votre-mot-de-passe',10))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# URL publique du site (success/cancel Stripe). Ex : https://coquelicot-lr.fr
NEXT_PUBLIC_SITE_URL=http://localhost:3000
